# LLM endpoint — any OpenAI-compatible API
# Default points at Hermes; override for vLLM/Ollama/OpenAI/OpenRouter
LLM_BASE_URL=http://localhost:8642
LLM_API_KEY=
LLM_MODEL=

# Storage
# Where the .md lands (your Obsidian vault YouTube folder)
OBSIDIAN_VAULT_PATH=~/.claude/obsidian-mind/youtube
# Where PDFs + catalog NDJSON live (gitignored)
OUTPUT_DIR=./output

# Service
HOST=127.0.0.1
PORT=18765
LOG_LEVEL=INFO

# Behaviour
MAX_CONCURRENT_JOBS=2
LLM_TIMEOUT_S=300
TRANSCRIPT_RETRIES=3

# Whisper fallback for captionless videos (Apple Silicon).
# Install the extra:  pip install -e '.[whisper]'
WHISPER_ENABLED=true
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
